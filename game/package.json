{
  "name": "human-override-overload",
  "version": "1.0.0",
  "description": "Korean-first 2D action survivor campaign portfolio for HUMAN OVERRIDE: OVERLOAD",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run analyze:assets && npm run typecheck && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "analyze:assets": "node scripts/production-asset-policy.mjs --report",
    "analyze:content": "node scripts/report-content-balance.mjs",
    "generate:agent-voice": "node scripts/generate-google-agent-voice.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "drizzle-orm": "^0.45.2",
    "phaser": "4.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.185.1",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@types/three": "0.185.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "5.9.3"
  }
}
